# Server
HOST=127.0.0.1
PORT=3000

# Database — path to the SQLite file (created on first run). Or set DATA_DIR to
# a directory instead. If neither is set, ./data is used when it already holds a
# database, otherwise the per-user OS data directory.
DB_PATH=./data/taxtracker.db

# Configuration mode. false (default): every setting comes from the environment and the app never
# writes configuration. true: SESSION_SECRET is generated into config.json in the data directory
# (mode 0600, no key material) and reused; anything set in the environment still wins. The CLI and
# installers turn this on; for a container, true needs the data volume to be writable and persistent.
# With true, delete the SESSION_SECRET line below (a value set here wins over the generated one),
# and API keys can be entered in the app under Settings (a key set here still wins). With false,
# API keys come only from here and Settings shows them read-only.
# AUTO_CONFIG=false

# Security — required unless AUTO_CONFIG=true; the app refuses to start with this placeholder or a short value.
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Every secret also accepts a _FILE variant (e.g. SESSION_SECRET_FILE=/run/secrets/session).
SESSION_SECRET=CHANGE_ME_generate_a_random_32_byte_hex_string

# Automatic unlock — optional. Only set this on a server that must restart without anyone
# signing in; it lets the data unlock itself at startup if you opt in when encrypting. The key
# then sits next to the data. Leave it commented out otherwise (a placeholder value is rejected).
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=

# Cookies: auto (Secure when the request arrived over HTTPS) | true | false
SECURE_COOKIES=auto
# Behind a reverse proxy, set so "auto" sees the original protocol:
# true | comma-separated IPs/CIDRs | loopback | linklocal | uniquelocal
# TRUST_PROXY=loopback

# Dividend history (optional — Alpha Vantage free tier, 25 req/day)
# Sign up at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Price data (optional — Tiingo free tier, internal use)
# Sign up at https://www.tiingo.com/
TIINGO_API_KEY=

# FX rate policy: "hmrc-monthly" | "daily-spot" (default: hmrc-monthly)
FX_RATE_POLICY=hmrc-monthly
