{
  "name": "uk-tax-tracker",
  "version": "0.1.0",
  "description": "UK share tax liability tracker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apilbeam101/tax-tracker.git"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "bin": {
    "tax-tracker": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "build:server": "tsc -p tsconfig.server.json && node -e \"const{cpSync}=require('fs');cpSync('src/server/db/migrations','dist/server/db/migrations',{recursive:true})\"",
    "build:client": "vite build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "start": "node dist/server/cli.js",
    "start:dev": "tsx src/server/cli.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "changelog:check": "tsx scripts/check-changelog.ts",
    "pack:check": "tsx scripts/check-pack-allowlist.ts",
    "pack:smoke": "tsx scripts/smoke-pack.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^8.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/session": "^11.1.3",
    "@fastify/static": "^10.1.5",
    "@node-rs/argon2": "^2.0.2",
    "big.js": "^7.0.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "fastify": "^5.12.5",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.6.3",
    "@types/pdfkit": "^0.17.6",
    "@vitest/coverage-v8": "^4.1.9",
    "pino": "^10.3.1",
    "svelte": "^5.57.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "pino-pretty": "^13.1.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
