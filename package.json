{
  "name": "claude-tax",
  "version": "0.1.0",
  "description": "UK share tax liability tracker",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "build:server": "tsc -p tsconfig.server.json && node -e \"const{cpSync}=require('fs');cpSync('src/server/db/migrations','dist/server/db/migrations',{recursive:true})\"",
    "build:client": "vite build",
    "build": "npm run build:client && npm run build:server",
    "start": "node --env-file=.env dist/server/main.js",
    "start:dev": "node --env-file=.env --import tsx/esm src/server/main.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "backup": "node --env-file=.env --import tsx/esm scripts/backup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^8.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^10.1.3",
    "@node-rs/argon2": "^2.0.2",
    "big.js": "^7.0.1",
    "csv-parse": "^7.0.0",
    "csv-stringify": "^6.8.0",
    "fastify": "^5.8.5",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.2.0",
    "@types/pdfkit": "^0.17.6",
    "@vitest/coverage-v8": "^4.1.9",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "svelte": "^5.56.3",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "esbuild": true
  }
}
