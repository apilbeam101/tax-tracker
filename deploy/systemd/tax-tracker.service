# UK Tax Tracker as a hardened system service. Needs systemd 250 or later (for %d), and a system
# Node.js 24+ on the default PATH (not one installed under /home, which ProtectHome hides).
#
# Install:
#   sudo npm install -g uk-tax-tracker          (puts `tax-tracker` in /usr/local/bin)
#   sudo install -d -m 0700 /etc/tax-tracker
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" | sudo tee /etc/tax-tracker/session-secret >/dev/null
#   sudo chmod 0400 /etc/tax-tracker/session-secret
#   sudo cp tax-tracker.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now tax-tracker
# Then open http://127.0.0.1:3000 (or put a reverse proxy in front of it) and create your account.
# `command -v tax-tracker` shows the path to use in ExecStart if yours is not /usr/local/bin.
[Unit]
Description=UK Tax Tracker
Documentation=https://github.com/apilbeam101/tax-tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tax-tracker start

# A restore uploaded from the app is applied at the next start; with RESTORE_RESTART=exit the app
# exits by itself (with status 0) once it is staged. Restart=always, not on-failure, is what
# brings it back after that clean exit.
Restart=always
RestartSec=5
TimeoutStopSec=30

# systemd creates a private user and manages the data directory: /var/lib/tax-tracker, owned by
# that user and unreadable by anyone else.
DynamicUser=yes
StateDirectory=tax-tracker
StateDirectoryMode=0700
UMask=0077

Environment=NODE_ENV=production
Environment=LOG_LEVEL=warn
Environment=DATA_DIR=/var/lib/tax-tracker
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=AUTO_CONFIG=false
Environment=BACKUP_SCHEDULE=daily
Environment=RESTORE_RESTART=exit
# Set when a reverse proxy on this host terminates TLS, so cookies are marked Secure. Use a
# comma-separated list of addresses if the proxy is on another host.
Environment=TRUST_PROXY=loopback

# Secrets are delivered as credentials: a private, in-memory copy readable only by this service,
# rather than an EnvironmentFile that every process of the service user can read.
LoadCredential=session-secret:/etc/tax-tracker/session-secret
Environment=SESSION_SECRET_FILE=%d/session-secret
# Optional API keys, the same way (create the files first):
#   LoadCredential=tiingo-api-key:/etc/tax-tracker/tiingo-api-key
#   Environment=TIINGO_API_KEY_FILE=%d/tiingo-api-key
# Optional unattended unlock: the data unlocks itself at startup, so the key sits on this host
# next to the data. Leave it out and the data stays locked after every restart until someone signs
# in.
#   LoadCredential=encryption-key:/etc/tax-tracker/encryption-key
#   Environment=ENCRYPTION_KEY_FILE=%d/encryption-key

# Hardening. MemoryDenyWriteExecute is deliberately not set: V8's JIT needs writable and
# executable memory. Check the result with `systemd-analyze security tax-tracker`.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
