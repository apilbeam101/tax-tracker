# Copy to .env next to docker-compose.yml. Every value is optional.

# Image tag. A minor tag (for example 0.1) follows patch releases and monthly base-image
# rebuilds; an exact version never changes.
# TAX_TRACKER_VERSION=0.1

# Host port, always bound to 127.0.0.1.
# TAX_TRACKER_PORT=3000

# Only used by `docker compose --profile https up -d`: the public name of this host.
# DOMAIN=tax.example.com
